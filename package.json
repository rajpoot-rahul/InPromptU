{
  "name": "impromptu-desktop",
  "productName": "Impromptu",
  "version": "0.2.7",
  "description": "A desktop companion for clearer prompts, Hyland knowledge and source-backed replies.",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package:mac": "node scripts/package.cjs darwin arm64",
    "package:windows": "node scripts/package.cjs win32 x64",
    "installer:mac": "npm run package:mac && node scripts/installer-mac.cjs arm64",
    "installer:windows": "npm run package:windows && node scripts/installer-windows.cjs",
    "dev": "node scripts/dev.cjs",
    "doctor": "node scripts/doctor.cjs",
    "verify": "npm run check && npm test",
    "stage:mac": "node scripts/stage-release.cjs mac",
    "stage:windows": "node scripts/stage-release.cjs windows"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0"
  },
  "engines": {
    "node": "24.x"
  }
}
